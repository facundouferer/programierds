---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { getLocalizedRelativePath } from '../../utils/paths';
import { LOCALES, useTranslations, type Locale } from '../../i18n';

export async function getStaticPaths() {
	return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const quickLinks = [
	{
		titleKey: 'home.quickLinks.courses.title',
		descriptionKey: 'home.quickLinks.courses.description',
		href: '/cursos',
		icon: 'menu_book',
		iconClasses: 'bg-primary/10 text-primary',
	},
	{
		titleKey: 'home.quickLinks.tests.title',
		descriptionKey: 'home.quickLinks.tests.description',
		href: '/test',
		icon: 'description',
		iconClasses: 'bg-accent-blue/10 text-accent-blue',
	},
	{
		titleKey: 'home.quickLinks.presentations.title',
		descriptionKey: 'home.quickLinks.presentations.description',
		href: '/presentaciones',
		icon: 'play_arrow',
		iconClasses: 'bg-accent-brown/10 text-accent-brown',
	},
	{
		titleKey: 'home.quickLinks.playground.title',
		descriptionKey: 'home.quickLinks.playground.description',
		href: '/playground',
		icon: 'terminal',
		iconClasses: 'bg-primary/10 text-primary',
	},
] as const;
---

<Layout title={t('site.title')}>
	<div class="relative flex min-h-screen flex-col overflow-x-hidden">
		<main class="flex-1">
			<section class="relative px-4 py-16 lg:px-20 lg:py-32">
				<div class="mx-auto max-w-7xl grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div class="flex flex-col gap-8">
						<div class="inline-flex w-fit items-center rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary border border-primary/20">
							🚀 {t('home.hero.eyebrow')}
						</div>
						<h1 class="text-slate-900 dark:text-white text-5xl font-black leading-tight tracking-tight lg:text-7xl">
							{t('home.hero.title')}
						</h1>
						<p class="text-slate-600 dark:text-slate-400 text-lg lg:text-xl max-w-xl">
							{t('home.hero.subtitle')}
						</p>
						<div class="flex flex-wrap gap-4">
							<a href={getLocalizedRelativePath(lang, '/playground')} class="flex h-14 items-center justify-center rounded-xl bg-primary px-8 text-lg font-bold text-background-dark hover:scale-105 transition-transform">
								{t('home.hero.ctaPlayground')}
							</a>
							<a href={getLocalizedRelativePath(lang, '/cursos')} class="flex h-14 items-center justify-center rounded-xl border border-primary/30 bg-primary/5 px-8 text-lg font-bold text-primary hover:bg-primary/10 transition-colors">
								{t('home.hero.ctaCourses')}
							</a>
						</div>
					</div>
					<div class="relative">
						<div class="absolute -inset-4 bg-primary/20 blur-3xl rounded-full"></div>
						<div class="relative rounded-2xl border border-primary/20 bg-background-dark/50 p-2 shadow-2xl overflow-hidden aspect-video">
							<img class="w-full h-full object-cover rounded-xl" alt="Workspace" src={getLocalizedRelativePath(lang, '/images/hero-workspace.jpg')}/>
						</div>
					</div>
				</div>
			</section>

			<section class="bg-primary/5 px-4 py-20 lg:px-20">
				<div class="mx-auto max-w-7xl">
					<div class="mb-16 text-center lg:text-left">
						<h2 class="text-slate-900 dark:text-white text-4xl font-bold tracking-tight">{t('home.quickLinks.title')}</h2>
						<p class="mt-4 text-slate-600 dark:text-slate-400 text-lg lg:text-xl">{t('home.quickLinks.subtitle')}</p>
					</div>
					<div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-4">
						{quickLinks.map((link) => (
							<a
								href={getLocalizedRelativePath(lang, link.href)}
								class="group relative flex h-full flex-col gap-6 rounded-2xl border border-primary/10 bg-background-light p-8 transition-all hover:border-primary/50 hover:-translate-y-1 dark:bg-background-dark"
							>
								<div class={`flex size-12 items-center justify-center rounded-lg ${link.iconClasses}`}>
									<Icon name={link.icon} class="h-6 w-6" />
								</div>
								<div>
									<h3 class="mb-2 text-xl font-bold text-slate-900 dark:text-white">{t(link.titleKey)}</h3>
									<p class="leading-relaxed text-slate-600 dark:text-slate-400">{t(link.descriptionKey)}</p>
								</div>
							</a>
						))}
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</div>
</Layout>
