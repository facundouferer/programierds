---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { LOCALES, useTranslations, type Locale } from '../../i18n';
import '@fontsource/fira-code/400.css';
import '@fontsource/fira-code/500.css';

export async function getStaticPaths() {
	return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<Layout title={`${t('playground.title')} - Programierds`}>
	<style>
		.code-font { font-family: 'Fira Code', monospace; }
		.custom-scrollbar::-webkit-scrollbar { width: 8px; height: 8px; }
		.custom-scrollbar::-webkit-scrollbar-track { background: #0a140d; }
		.custom-scrollbar::-webkit-scrollbar-thumb { background: #0df25933; border-radius: 10px; }
		.custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #0df25966; }
		#code-editor-container .cm-editor { height: 100%; font-family: 'Fira Code', monospace; font-size: 0.875rem; }
		#code-editor-container .cm-scroller { overflow: auto; }
		#code-editor-container .cm-gutters { border-right: 1px solid rgba(13, 242, 89, 0.05); }
	</style>
	<style is:global>
		#code-editor-container .cm-line.cm-step-highlight {
			background-color: rgba(13, 242, 89, 0.15) !important;
			border-left: 3px solid #0df259;
			transition: background-color 0.2s ease;
		}
	</style>

	<div class="relative flex h-screen flex-col overflow-hidden">
		<div class="flex items-center justify-between px-4 lg:px-8 py-2 bg-background-dark border-b border-primary/5">
			<div class="flex items-center gap-4">
				<div class="relative" id="lang-dropdown">
					<button id="lang-toggle" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-primary/5 border border-primary/20 hover:border-primary/40 transition-colors text-xs font-bold text-slate-300">
						<span id="lang-label">JavaScript</span>
						<Icon name="expand_more" class="w-4 h-4 text-primary" />
					</button>
					<div id="lang-menu" class="hidden absolute top-full left-0 mt-1 w-44 rounded-lg bg-background-dark border border-primary/20 shadow-lg shadow-black/50 overflow-hidden z-50">
						<button data-lang="javascript" data-file="main.js" class="lang-option w-full flex items-center gap-3 px-4 py-2.5 text-xs font-medium text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
							<Icon name="javascript" class="w-4 h-4" /> JavaScript
						</button>
						<button data-lang="java" data-file="Main.java" class="lang-option w-full flex items-center gap-3 px-4 py-2.5 text-xs font-medium text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
							<Icon name="code" class="w-4 h-4" /> Java
						</button>
						<button data-lang="c" data-file="main.c" class="lang-option w-full flex items-center gap-3 px-4 py-2.5 text-xs font-medium text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
							<Icon name="code" class="w-4 h-4" /> C
						</button>
						<button data-lang="python" data-file="main.py" class="lang-option w-full flex items-center gap-3 px-4 py-2.5 text-xs font-medium text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors">
							<Icon name="code" class="w-4 h-4" /> Python
						</button>
					</div>
				</div>
				<div class="h-4 w-px bg-primary/10"></div>
				<div class="flex items-center gap-2 text-xs font-mono text-slate-400">
					<Icon name="description" class="w-4 h-4" />
					<span id="file-name">main.js</span>
				</div>
			</div>
			<div class="flex items-center gap-3">
				<button id="run-btn" class="flex items-center gap-2 px-6 py-2 rounded-lg bg-primary text-background-dark font-black text-sm uppercase tracking-wider hover:brightness-110 active:scale-95 transition-all shadow-[0_0_20px_-5px_rgba(13,242,89,0.4)]">
					<Icon name="play_arrow" class="w-5 h-5" />
					{t('playground.runButton')}
				</button>
			</div>
		</div>

		<main class="flex-1 flex overflow-hidden">
			<div id="code-editor-container" class="flex-1 flex flex-col border-r border-primary/10"></div>

			<div class="w-1/3 min-w-[350px] flex flex-col bg-terminal-bg">
				<div id="stdin-panel" class="hidden border-b border-primary/10">
					<div class="px-4 py-2 border-b border-primary/5 flex items-center gap-2">
						<Icon name="terminal" class="w-3 h-3 text-yellow-400" />
						<span class="text-[10px] font-bold uppercase tracking-widest text-yellow-400">{t('playground.inputTitle')}</span>
					</div>
					<textarea
						id="stdin-input"
						class="w-full bg-terminal-bg text-slate-400 p-3 code-font text-xs leading-relaxed focus:outline-none resize-none custom-scrollbar h-20"
						spellcheck="false"
					></textarea>
				</div>
				<div class="px-4 py-2 border-b border-primary/10 flex items-center justify-between bg-terminal-bg">
					<div class="flex items-center gap-2">
						<Icon name="terminal" class="w-4 h-4 text-primary" />
						<span class="text-xs font-bold uppercase tracking-widest text-slate-400">{t('playground.outputTitle')}</span>
					</div>
					<button id="clear-btn" class="text-slate-500 hover:text-white transition-colors" aria-label={t('playground.clearButton')}>
						<Icon name="delete_sweep" class="w-4 h-4" />
					</button>
				</div>
				<div id="terminal-output" class="flex-1 p-4 code-font text-sm custom-scrollbar overflow-y-auto" data-idle-msg={t('playground.idle')}>
					<div class="text-slate-500 italic text-xs">{t('playground.idle')}</div>
				</div>
			</div>
		</main>

		<footer class="h-8 border-t border-primary/10 bg-background-dark px-4 flex items-center justify-between text-[10px] text-slate-500 font-mono">
			<div class="flex items-center gap-4">
				<div class="flex items-center gap-1">
					<Icon name="fork_right" class="w-3 h-3" />
					<span>main*</span>
				</div>
			</div>
			<div class="flex items-center gap-4">
				<span id="footer-position">Ln 1, Col 1</span>
				<span>UTF-8</span>
				<span id="footer-lang" class="text-primary font-bold">JavaScript</span>
			</div>
		</footer>
	</div>

	<script>
		import { EditorView, basicSetup } from 'codemirror';
		import { EditorState, Compartment } from '@codemirror/state';
		import { javascript } from '@codemirror/lang-javascript';
		import { java } from '@codemirror/lang-java';
		import { cpp } from '@codemirror/lang-cpp';
		import { python } from '@codemirror/lang-python';
		import { oneDark } from '@codemirror/theme-one-dark';
		import { keymap } from '@codemirror/view';
		import { indentWithTab } from '@codemirror/commands';

		const JUDGE0_URL = 'https://ce.judge0.com';
		const LANG_IDS: Record<string, number> = { javascript: 102, java: 91, c: 50, python: 71 };

		const defaultCodes: Record<string, string> = {
			javascript: `// Programierds Code Playground\n\nfunction helloWorld() {\n    console.log("Hello from Programierds");\n    return "done";\n}\n\nhelloWorld();`,
			java: `public class Main {\n    public static void main(String[] args) {\n        System.out.println("Hello from Programierds");\n    }\n}`,
			c: `#include <stdio.h>\n\nint main() {\n    printf("Hello from Programierds\\n");\n    return 0;\n}`,
			python: `print("Hello from Programierds")`,
		};

		let currentLang = 'javascript';
		const langCompartment = new Compartment();
		const editorContainer = document.getElementById('code-editor-container')!;

		const editorView = new EditorView({
			state: EditorState.create({
				doc: defaultCodes.javascript,
				extensions: [
					basicSetup,
					keymap.of([indentWithTab]),
					oneDark,
					langCompartment.of(javascript()),
					EditorView.updateListener.of((update) => {
						if (update.docChanged) onCodeChange();
						if (update.selectionSet) updateFooterPosition();
					}),
				],
			}),
			parent: editorContainer,
		});

		const stdinInput = document.getElementById('stdin-input') as HTMLTextAreaElement;
		const stdinPanel = document.getElementById('stdin-panel')!;
		const terminal = document.getElementById('terminal-output')!;
		const runBtn = document.getElementById('run-btn')!;
		const clearBtn = document.getElementById('clear-btn')!;
		const toggle = document.getElementById('lang-toggle')!;
		const menu = document.getElementById('lang-menu')!;
		const langLabel = document.getElementById('lang-label')!;
		const fileNameEl = document.getElementById('file-name')!;
		const footerLang = document.getElementById('footer-lang')!;
		const footerPos = document.getElementById('footer-position')!;
		const idleMsg = terminal.dataset.idleMsg ?? '// idle';

		function getCode(): string { return editorView.state.doc.toString(); }
		function setCode(code: string) {
			editorView.dispatch({ changes: { from: 0, to: editorView.state.doc.length, insert: code } });
		}
		function onCodeChange() { updateStdinVisibility(getCode()); }
		function updateFooterPosition() {
			const pos = editorView.state.selection.main.head;
			const line = editorView.state.doc.lineAt(pos);
			footerPos.textContent = `Ln ${line.number}, Col ${pos - line.from + 1}`;
		}
		function detectNeedsStdin(code: string): boolean {
			if (currentLang === 'java') return /Scanner|System\.in|BufferedReader/.test(code);
			if (currentLang === 'javascript') return /readline|process\.stdin|prompt\(/.test(code);
			if (currentLang === 'c') return /scanf|fgets|getchar|gets/.test(code);
			if (currentLang === 'python') return /input\(/.test(code);
			return false;
		}
		function updateStdinVisibility(code: string) { stdinPanel.classList.toggle('hidden', !detectNeedsStdin(code)); }
		function setTerminalContent(html: string) { terminal.innerHTML = html; terminal.scrollTop = terminal.scrollHeight; }
		function appendTerminalLine(text: string, cls = 'text-slate-400') {
			const div = document.createElement('div');
			div.className = cls;
			div.textContent = text;
			terminal.appendChild(div);
			terminal.scrollTop = terminal.scrollHeight;
		}
		function prepareJavaCode(code: string): string {
			return code.replace(/^\s*package\s+[\w.]+\s*;\s*\n?/m, '').replace(/public\s+class\s+(\w+)/, 'public class Main');
		}

		async function captureJavaScript(code: string) {
			const logs: string[] = [];
			const orig = console.log;
			console.log = (...args) => logs.push(args.map(String).join(' '));
			let error: string | null = null;
			try { new Function(code)(); }
			catch (e) { error = e instanceof Error ? e.message : String(e); }
			finally { console.log = orig; }
			return { outputs: logs, error };
		}

		async function runJavaScript(code: string) {
			const { outputs, error } = await captureJavaScript(code);
			setTerminalContent('');
			for (const line of outputs) appendTerminalLine(line, 'text-slate-300');
			if (error) appendTerminalLine(error, 'text-red-400 font-medium');
		}

		async function runWithJudge0(code: string, lang: string) {
			const sourceCode = lang === 'java' ? prepareJavaCode(code) : code;
			const body: Record<string, unknown> = {
				language_id: LANG_IDS[lang],
				source_code: btoa(unescape(encodeURIComponent(sourceCode))),
			};
			if (stdinInput.value.trim()) body.stdin = btoa(unescape(encodeURIComponent(stdinInput.value.trim())));

			setTerminalContent('');
			appendTerminalLine(`${t('playground.running')}`.replace(/^t\(.*\)$/, 'Running...'), 'text-yellow-400 animate-pulse');

			try {
				const res = await fetch(`${JUDGE0_URL}/submissions?base64_encoded=true&wait=true`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(body),
				});
				let data = await res.json();
				while (data.status && (data.status.id === 1 || data.status.id === 2)) {
					await new Promise((r) => setTimeout(r, 1000));
					const poll = await fetch(`${JUDGE0_URL}/submissions/${data.token}?base64_encoded=true`);
					data = await poll.json();
				}
				const decode = (b64: string | null) => {
					if (!b64) return '';
					try { return new TextDecoder().decode(Uint8Array.from(atob(b64), (c) => c.charCodeAt(0))); }
					catch { return atob(b64); }
				};
				setTerminalContent('');
				const stdout = decode(data.stdout);
				const stderr = decode(data.stderr);
				const compileOutput = decode(data.compile_output);
				if (compileOutput && data.status?.id !== 3) {
					for (const l of compileOutput.split('\n')) if (l.trim()) appendTerminalLine(l, 'text-red-400');
				}
				if (stdout) for (const l of stdout.split('\n')) if (l !== '') appendTerminalLine(l, 'text-slate-300');
				if (stderr) for (const l of stderr.split('\n')) if (l.trim()) appendTerminalLine(l, 'text-red-400');
			} catch (e) {
				setTerminalContent('');
				appendTerminalLine(e instanceof Error ? e.message : String(e), 'text-red-400');
			}
		}

		runBtn.addEventListener('click', async () => {
			const code = getCode();
			if (currentLang === 'javascript') await runJavaScript(code);
			else await runWithJudge0(code, currentLang);
		});

		clearBtn.addEventListener('click', () => {
			setTerminalContent(`<div class="text-slate-500 italic text-xs">${idleMsg}</div>`);
		});

		toggle.addEventListener('click', () => menu.classList.toggle('hidden'));

		document.querySelectorAll('.lang-option').forEach((option) => {
			option.addEventListener('click', () => {
				const lang = option.getAttribute('data-lang') ?? 'javascript';
				const file = option.getAttribute('data-file') ?? 'main.js';
				const labels: Record<string, string> = { javascript: 'JavaScript', java: 'Java', c: 'C', python: 'Python' };
				const label = labels[lang] ?? lang;
				currentLang = lang;
				langLabel.textContent = label;
				fileNameEl.textContent = file;
				footerLang.textContent = label;
				editorView.dispatch({
					effects: langCompartment.reconfigure(
						lang === 'java' ? java() : lang === 'c' ? cpp() : lang === 'python' ? python() : javascript(),
					),
				});
				setCode(defaultCodes[lang]);
				stdinInput.value = '';
				updateStdinVisibility(defaultCodes[lang]);
				setTerminalContent(`<div class="text-slate-500 italic text-xs">${idleMsg}</div>`);
				menu.classList.add('hidden');
			});
		});

		document.addEventListener('click', (e) => {
			const dropdown = document.getElementById('lang-dropdown');
			if (dropdown && !dropdown.contains(e.target as Node)) menu.classList.add('hidden');
		});

		// locale label unused in scripts; stub to satisfy t() calls
		function t(key: string): string { return key; }
	</script>
</Layout>
