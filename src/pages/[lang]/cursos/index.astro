---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import { getCoursesForLocale, getChaptersForCourse } from '../../../utils/content';
import { getLocalizedRelativePath } from '../../../utils/paths';
import { LOCALES, useTranslations, type Locale } from '../../../i18n';

export async function getStaticPaths() {
	return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const courses = await getCoursesForLocale(lang);

const difficultyConfig: Record<string, { labelKey: string; color: string; border: string; bg: string }> = {
	Beginner: { labelKey: 'course.detail.difficulty.beginner', color: 'text-primary', border: 'border-primary/20', bg: 'bg-primary/10' },
	Intermediate: { labelKey: 'course.detail.difficulty.intermediate', color: 'text-accent-blue', border: 'border-accent-blue/20', bg: 'bg-accent-blue/10' },
	Advanced: { labelKey: 'course.detail.difficulty.advanced', color: 'text-purple-400', border: 'border-purple-500/20', bg: 'bg-purple-500/10' },
};

const coursesWithChapters = await Promise.all(
	courses.map(async ({ entry }) => {
		const courseSlug = entry.id.replace('/index', '');
		const chapters = await getChaptersForCourse(courseSlug, lang);
		return { entry, slug: courseSlug, chapterCount: chapters.length };
	}),
);
---

<Layout title={`${t('courses.index.title')} - Programierds`}>
	<div class="relative flex min-h-screen flex-col overflow-x-hidden">
		<main class="flex-1 px-4 lg:px-20 py-12">
			<div class="mx-auto max-w-7xl">
				<div class="mb-12">
					<h1 class="text-4xl lg:text-6xl font-black text-slate-900 dark:text-white mb-4">{t('courses.index.title')}</h1>
					<p class="text-xl text-slate-600 dark:text-slate-400">{t('courses.index.subtitle')}</p>
				</div>

				{coursesWithChapters.length === 0 ? (
					<p class="text-slate-500">{t('courses.index.empty')}</p>
				) : (
					<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
						{coursesWithChapters.map(({ entry, slug, chapterCount }) => {
							const config = difficultyConfig[entry.data.difficulty];
							const iconName = entry.data.technology.toLowerCase();
							return (
								<a href={getLocalizedRelativePath(lang, `/cursos/${slug}`)} class="group flex flex-col rounded-2xl border border-primary/10 bg-background-light dark:bg-background-dark p-6 hover:border-primary/50 transition-all hover:shadow-[0_0_30px_-5px_rgba(13,242,89,0.15)]">
									<div class="flex justify-between items-start mb-6">
										<div class={`size-14 flex items-center justify-center rounded-xl ${config.bg} ${config.color}`}>
											<Icon name={iconName} class="w-9 h-9" />
										</div>
										<span class={`px-3 py-1 text-[10px] font-black uppercase tracking-widest ${config.bg} ${config.color} rounded-full border ${config.border}`}>
											{t(config.labelKey)}
										</span>
									</div>
									<h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">{entry.data.technology}</h3>
									<p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-6 flex-1">
										{entry.data.description}
									</p>
									<div class="flex items-center justify-between pt-6 border-t border-primary/10">
										<div class="flex items-center gap-2 text-slate-500">
											<Icon name="menu_book" class="w-4 h-4 text-primary" />
											<span class="text-sm font-medium">{chapterCount} {t('courses.card.lessons')}</span>
										</div>
										<span class="px-6 py-2 rounded-lg bg-primary text-background-dark font-bold text-sm group-hover:scale-105 transition-transform">
											{t('courses.card.startButton')}
										</span>
									</div>
								</a>
							);
						})}
					</div>
				)}
			</div>
		</main>
		<Footer />
	</div>
</Layout>
