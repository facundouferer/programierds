---
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import Layout from '../../../layouts/Layout.astro';
import { getTestsForLocale } from '../../../utils/content';
import { getLocalizedRelativePath } from '../../../utils/paths';
import { assertUniqueTestSlugs, buildTestSummaries, formatDifficultyLabel } from '../../../utils/tests';
import { LOCALES, useTranslations, type Locale } from '../../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const localizedTests = await getTestsForLocale(lang);
const testEntries = localizedTests.map(({ entry }) => entry);
assertUniqueTestSlugs(testEntries);

const summaries = buildTestSummaries(testEntries);

const categories = ['all', ...new Set(summaries.map((s) => s.category))].map((cat) => ({
  label: cat === 'all' ? (lang === 'en' ? '~/all' : '~/todos') : cat,
  filter: cat,
}));

const difficulties = (['all', ...new Set(summaries.map((s) => s.difficulty).filter(Boolean))] as const).map((diff) => ({
  label: diff === 'all' ? (lang === 'en' ? 'Any' : 'Libre') : formatDifficultyLabel(diff),
  filter: diff === 'all' ? 'all' : diff,
}));
---

<Layout title={`${t('tests.index.title')} - Programierds`}>
  <style>
    .glow-card { box-shadow: 0 0 20px rgba(13, 242, 89, 0.05), inset 0 0 10px rgba(13, 242, 89, 0.05); transition: all 0.3s ease; }
    .glow-card:hover { box-shadow: 0 0 30px rgba(13, 242, 89, 0.25), inset 0 0 15px rgba(13, 242, 89, 0.1); transform: translateY(-2px); }
    .filter-btn.active { background: rgba(13, 242, 89, 0.1); color: #0df259; border: 1px solid rgba(13, 242, 89, 0.2); }
    .filter-btn:not(.active) { color: #94a3b8; }
    .filter-btn:not(.active):hover { color: #0df259; background: rgba(13, 242, 89, 0.05); }
  </style>

  <div class="relative flex min-h-screen flex-col overflow-x-hidden">
    <main class="flex-1 flex flex-col lg:flex-row mx-auto w-full relative z-10">
      <aside class="hidden lg:block w-72 shrink-0 border-r border-primary/10 p-8 bg-background-dark/50">
        <div class="sticky top-24 space-y-12">
          <div>
            <h3 class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-primary/60 mb-6 flex items-center gap-2">
              <Icon name="folder" class="w-4 h-4" />
              {lang === 'en' ? 'CATEGORIES' : 'CATEGORÍAS'}
            </h3>
            <ul class="space-y-2 font-mono text-sm" id="category-filter-list">
              {categories.map((cat) => (
                <li>
                  <button
                    data-filter={cat.filter}
                    class:list={[
                      'filter-btn flex items-center gap-3 px-3 py-2 rounded-md w-full text-left transition-all',
                      cat.filter === 'all' ? 'active' : '',
                    ]}
                  >
                    <Icon name="folder" class="w-5 h-5" />
                    {cat.label}
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-primary/60 mb-6 flex items-center gap-2">
              <Icon name="tune" class="w-4 h-4" />
              {lang === 'en' ? 'DIFFICULTY' : 'DIFICULTAD'}
            </h3>
            <ul class="space-y-2 font-mono text-sm" id="difficulty-filter-list">
              {difficulties.map((diff) => (
                <li>
                  <button
                    data-filter={diff.filter}
                    class:list={[
                      'filter-btn flex items-center gap-3 px-3 py-2 rounded-md w-full text-left transition-all',
                      diff.filter === 'all' ? 'active' : '',
                    ]}
                  >
                    <Icon name="tune" class="w-5 h-5" />
                    {diff.label}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>

      <section class="flex-1 p-8 lg:p-12">
        <header class="mb-12">
          <h1 class="text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mb-3">{t('tests.index.title')}</h1>
        </header>

        {summaries.length === 0 ? (
          <p class="mt-10 text-slate-500">{t('tests.index.empty')}</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="cards-grid">
            {summaries.map((test) => {
              const isCodeOrdering = test.kind === 'code-ordering';
              const iconName = isCodeOrdering ? 'terminal' : 'bug_report';
              const countLabel = isCodeOrdering ? t('tests.card.lines') : t('tests.card.questions');

              const cardClass = isCodeOrdering
                ? 'group flex h-full flex-col rounded-[1.75rem] border-2 border-accent-blue/35 bg-accent-blue/5 p-6 transition-all hover:-translate-y-1 hover:border-accent-blue/70 hover:shadow-[0_30px_80px_-60px_rgba(59,130,246,0.65)] dark:bg-accent-blue/10'
                : 'group flex h-full flex-col rounded-[1.75rem] border border-primary/10 bg-background-light p-6 transition-all hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_30px_80px_-60px_rgba(13,242,89,0.55)] dark:bg-background-dark';

              const iconClass = isCodeOrdering
                ? 'flex size-14 items-center justify-center rounded-2xl bg-accent-blue/20 text-accent-blue'
                : 'flex size-14 items-center justify-center rounded-2xl bg-primary/10 text-primary';

              const difficultyClass = isCodeOrdering
                ? 'rounded-full border border-accent-blue/30 bg-accent-blue/15 px-3 py-1 text-[10px] font-black uppercase tracking-[0.24em] text-accent-blue'
                : 'rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-[10px] font-black uppercase tracking-[0.24em] text-primary';

              const buttonClass = isCodeOrdering
                ? 'inline-flex h-11 items-center justify-center rounded-xl bg-accent-blue px-5 text-sm font-black text-white transition-transform group-hover:scale-105'
                : 'inline-flex h-11 items-center justify-center rounded-xl bg-primary px-5 text-sm font-black text-background-dark transition-transform group-hover:scale-105';

              return (
                <a
                  class={cardClass}
                  href={getLocalizedRelativePath(lang, `/test/${test.slug}`)}
                  data-category={test.category}
                  data-difficulty={test.difficulty ?? ''}
                >
                  <div class="mb-6 flex items-start justify-between gap-4">
                    <div class={iconClass}>
                      <Icon name={iconName} class="h-7 w-7" />
                    </div>
                    <span class={difficultyClass}>
                      {formatDifficultyLabel(test.difficulty)}
                    </span>
                  </div>

                  <div class="flex-1 space-y-4">
                    <p class="text-xs font-black uppercase tracking-[0.2em] text-accent-blue">{test.category}</p>
                    <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">{test.title}</h2>
                    <p class="text-base leading-relaxed text-slate-600 dark:text-slate-400">{test.description}</p>
                  </div>

                  <div class="mt-8 grid grid-cols-2 gap-3 border-t border-primary/10 pt-5 text-sm">
                    <div class="rounded-2xl bg-primary/5 px-4 py-3">
                      <p class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">{countLabel}</p>
                      <p class="mt-2 text-xl font-black text-slate-900 dark:text-white">{test.questionCount}</p>
                    </div>
                    <div class="rounded-2xl bg-accent-blue/5 px-4 py-3">
                      <p class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">{t('tests.card.minutes')}</p>
                      <p class="mt-2 text-xl font-black text-slate-900 dark:text-white">{test.timeEstimate ?? '-'}</p>
                    </div>
                  </div>

                  <div class="mt-6 flex items-center justify-end">
                    <span class={buttonClass}>{t('tests.card.startButton')}</span>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </section>
    </main>

    <Footer />

    <script>
      function initFilters() {
        const cards = document.querySelectorAll<HTMLElement>('#cards-grid > a');
        const categoryFilters = document.querySelectorAll<HTMLButtonElement>('#category-filter-list .filter-btn');
        const difficultyFilters = document.querySelectorAll<HTMLButtonElement>('#difficulty-filter-list .filter-btn');

        let activeCategory = 'all';
        let activeDifficulty = 'all';

        function applyFilters() {
          cards.forEach((card) => {
            const cardCategory = card.dataset.category ?? '';
            const cardDifficulty = card.dataset.difficulty ?? '';
            const categoryMatch = activeCategory === 'all' || cardCategory === activeCategory;
            const difficultyMatch = activeDifficulty === 'all' || cardDifficulty === activeDifficulty;
            card.style.display = categoryMatch && difficultyMatch ? '' : 'none';
          });
        }

        categoryFilters.forEach((btn) => {
          btn.addEventListener('click', () => {
            activeCategory = btn.dataset.filter ?? 'all';
            categoryFilters.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            applyFilters();
          });
        });

        difficultyFilters.forEach((btn) => {
          btn.addEventListener('click', () => {
            activeDifficulty = btn.dataset.filter ?? 'all';
            difficultyFilters.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            applyFilters();
          });
        });
      }

      initFilters();
      document.addEventListener('astro:after-swap', initFilters);
    </script>
  </div>
</Layout>
